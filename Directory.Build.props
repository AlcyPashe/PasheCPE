<Project>
  <!-- Configuración común a todos los proyectos de PasheCPE -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>es-PE</NeutralLanguage>
    <IsPackable>false</IsPackable>

    <!-- Metadatos -->
    <Company>Pashe Soluciones</Company>
    <Authors>Pashe Soluciones</Authors>
    <Product>PasheCPE</Product>
    <Copyright>© Pashe Soluciones</Copyright>
    <RepositoryUrl>https://github.com/AlcyPashe/PasheCPE</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <!-- En los proyectos de src\ se activan: IsPackable, GenerateDocumentationFile, DebugType=embedded y Source Link (Fase 0). -->
</Project>
