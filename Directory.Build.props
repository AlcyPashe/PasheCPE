<Project>
  <!-- Configuración común a todos los proyectos de PasheCPE -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>es-PE</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <!-- Versión local de toda la solución; en publicar.yml la reemplaza -p:Version con la del tag -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <!-- Metadatos -->
    <Company>Pashe Soluciones</Company>
    <Authors>Pashe Soluciones</Authors>
    <Product>PasheCPE</Product>
    <Copyright>© Pashe Soluciones</Copyright>
    <RepositoryUrl>https://github.com/AlcyPashe/PasheCPE</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <!-- Ajustes por carpeta: src\Directory.Build.props (paquetes NuGet, XML-docs, PDB embebido, Source Link)
       y tests\Directory.Build.props (xUnit v3 con VSTest). Versiones en Directory.Packages.props. -->
</Project>
