<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta de desarrollo: Excel de reglas de SUNAT → recursos embebidos de PasheCPE. No se distribuye. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PasheCPE.GeneradorRecursos</RootNamespace>
    <!-- Sin .exe propio: dotnet run lo ejecuta con dotnet.exe (firmado por Microsoft), así el antivirus no lo bloquea. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeneradorRecursos.Tests" />
  </ItemGroup>

</Project>
