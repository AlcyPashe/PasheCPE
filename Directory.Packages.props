<Project>
  <!-- Central Package Management: únicas dependencias permitidas (TRD §1). Cualquier otra se consulta antes. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="PasheCPE">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.XmlSerializer.Generator" Version="10.0.13" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup Label="PasheCPE.Pdf">
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <!-- xunit.v3.mtp-off: xUnit v3 sin Microsoft Testing Platform, para ejecutarse con VSTest en el SDK 10 -->
  <ItemGroup Label="Pruebas">
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup Label="Herramientas (no se distribuyen)">
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
