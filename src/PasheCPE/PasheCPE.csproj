<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PasheCPE</RootNamespace>
    <PackageId>PasheCPE</PackageId>
    <Description>Comprobantes y guías electrónicas SUNAT: UBL 2.1, validación local (XSD, XSL SUNAT y reglas complementarias del Excel, incluidas las de 2027), firma, ZIP, envío SOAP a SUNAT u OSE, GRE por API REST, control de respuestas, historial y QR.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.XmlSerializer.Generator" />
  </ItemGroup>

  <!-- Pregeneración de serializadores (TRD §3.1): solo los documentos UBL raíz. -->
  <PropertyGroup>
    <SGenTypes>PasheCPE.Ubl.Invoice;PasheCPE.Ubl.CreditNote;PasheCPE.Ubl.DebitNote</SGenTypes>
  </PropertyGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.XmlSerializer.Generator" Version="10.0.13" />
  </ItemGroup>

  <!-- Datos versionados (TRD §3.3): generados por tools/GeneradorRecursos o mantenidos a mano -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\*.json" LogicalName="PasheCPE.Recursos.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Recursos\catalogos\*.xml" LogicalName="PasheCPE.Recursos.catalogos.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- XSD oficiales (TRD §9.2): enlazados desde recursos\XSD, sin copiarlos (una sola fuente) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\recursos\XSD\2.1\common\*.xsd"
                      LogicalName="PasheCPE.Recursos.xsd.2.1.common.%(Filename)%(Extension)"
                      Link="Recursos\xsd\2.1\common\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\recursos\XSD\2.1\maindoc\UBL-Invoice-2.1.xsd;..\..\recursos\XSD\2.1\maindoc\UBL-CreditNote-2.1.xsd;..\..\recursos\XSD\2.1\maindoc\UBL-DebitNote-2.1.xsd;..\..\recursos\XSD\2.1\maindoc\UBL-DespatchAdvice-2.1.xsd;..\..\recursos\XSD\2.1\maindoc\UBL-ApplicationResponse-2.1.xsd"
                      LogicalName="PasheCPE.Recursos.xsd.2.1.maindoc.%(Filename)%(Extension)"
                      Link="Recursos\xsd\2.1\maindoc\%(Filename)%(Extension)" />
    <!-- UBL 2.0 (resumen diario): conjunto aparte, porque comparte los namespaces de UBL 2.1 -->
    <EmbeddedResource Include="..\..\recursos\XSD\2.0\common\*.xsd"
                      LogicalName="PasheCPE.Recursos.xsd.2.0.common.%(Filename)%(Extension)"
                      Link="Recursos\xsd\2.0\common\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\recursos\XSD\2.0\maindoc\UBLPE-SummaryDocuments-1.0.xsd"
                      LogicalName="PasheCPE.Recursos.xsd.2.0.maindoc.%(Filename)%(Extension)"
                      Link="Recursos\xsd\2.0\maindoc\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- XSL oficiales (TRD §9.3): enlazadas desde recursos\XSL sin copiarlas; utilidades propias que emulan DataPower -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\recursos\XSL\ValidaExprRegFactura-2.0.1.xsl;..\..\recursos\XSL\ValidaExprRegBoleta-2.0.1.xsl;..\..\recursos\XSL\ValidaExprRegNC-2.0.1.xsl;..\..\recursos\XSL\ValidaExprRegND-2.0.1.xsl;..\..\recursos\XSL\ValidaExprRegSummary-1.1.0.xsl;..\..\recursos\XSL\ValidaExprRegSummaryVoided-1.0.1.xsl;..\..\recursos\XSL\ValidaExprRegGuiaRemitente-2.0.1.xsl"
                      LogicalName="PasheCPE.Recursos.xsl.%(Filename)%(Extension)"
                      Link="Recursos\xsl\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Recursos\xsl-utils\*" LogicalName="PasheCPE.Recursos.xsl-utils.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasheCPE.Tests" />
  </ItemGroup>

</Project>
