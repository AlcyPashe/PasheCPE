<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PasheCPE.Pdf</RootNamespace>
    <PackageId>PasheCPE.Pdf</PackageId>
    <Description>Representación impresa A4 de los comprobantes (01, 03, 07, 08) y guías (09, 31) generados con PasheCPE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasheCPE\PasheCPE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Recursos\*.json" LogicalName="PasheCPE.Pdf.Recursos.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasheCPE.Pdf.Tests" />
  </ItemGroup>

  <!-- PasheCPE.Pdf usa tipos internos de PasheCPE (TRD §2): el paquete depende de la versión exacta [x.y.z] de PasheCPE. -->
  <Target Name="DependenciaExactaPasheCpe" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_VersionExacta Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_VersionExacta)" />
    </ItemGroup>
  </Target>

</Project>
