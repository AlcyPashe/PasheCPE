# Normalización por defecto
* text=auto

# Código y scripts
*.cs     text diff=csharp
*.csproj text
*.slnx   text
*.props  text
*.ps1    text eol=crlf
*.md     text
*.json   text
*.yml    text

# Fuentes oficiales SUNAT: se conservan byte a byte
recursos/** -text

# Datos de prueba (XML firmados, CDR, respuestas grabadas): byte a byte
tests/Datos/** -text

# Binarios
*.pfx binary
*.p12 binary
*.zip binary
*.png binary
*.pdf binary
*.xlsx binary
*.ttf binary
