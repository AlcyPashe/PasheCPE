# Normalización por defecto
* text=auto

# Código y scripts
*.cs     text diff=csharp
*.csproj text
*.slnx   text
*.props  text
*.ps1    text eol=crlf
*.md     text
*.json   text
*.yml    text

# Fuentes oficiales SUNAT: se conservan byte a byte
recursos/** -text

# Datos de prueba (XML firmados, CDR, respuestas grabadas): byte a byte
tests/Datos/** -text

# Recursos generados y datos curados del generador: siempre LF (las pruebas comparan byte a byte)
src/PasheCPE/Recursos/** text eol=lf
src/PasheCPE/Catalogos/*.g.cs text eol=lf
tools/GeneradorRecursos/Datos/** text eol=lf

# Binarios
*.pfx binary
*.p12 binary
*.zip binary
*.png binary
*.pdf binary
*.xlsx binary
*.ttf binary
