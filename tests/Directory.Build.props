<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- xUnit v3 ejecutado con VSTest (dotnet test PasheCPE.slnx). Las pruebas nunca llaman a SUNAT ni al OSE. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- UseAppHost no se puede desactivar aquí: xunit.v3.core.mtp-off lo fuerza a true y falla la compilación si es false
         (cada proyecto de prueba de xUnit v3 es un ejecutable). Si el antivirus bloquea los .Tests.exe, excluir tests\*\bin. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
